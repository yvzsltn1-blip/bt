{
  "manifest_version": 3,
  "name": "Bite Elite Bitefight Ancestral Ruins",
  "version": "4.0.0",
  "description": "Protector SaaS - Sistema de Licencias Firebase (Ancestral Ruins Edition)",
  "author": "Bite Elite Team",
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bitefight.gameforge.com/*"
      ],
      "js": [
        "firebase-app.js",
        "firebase-auth.js",
        "firebase-firestore.js",
        "firebase_config.js",
        "auth.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.bitefight.gameforge.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bite-elite-bot@beetlejuice.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "icon128.png"
      ],
      "matches": [
        "*://*.bitefight.gameforge.com/*"
      ]
    }
  ]
}